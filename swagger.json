  "info": {
    "title": "Recruitment Platform API",
    "description": "Backend APIs for Recruitment Pipeline & Interview Intelligence Platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "BaseResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Request processed successfully"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "RoleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6d0b5c72-3e4d-4d36-a070-1d8f1e4b7c67"
          },
          "name": {
            "type": "string",
            "example": "Recruiter"
          },
          "code": {
            "type": "string",
            "example": "RECRUITER"
          },
          "description": {
            "type": "object",
            "example": "Handles candidate pipeline and coordination"
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-01T10:00:00.000Z"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-02T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "code",
          "created_at",
          "updated_at"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9c0a8c8f-820a-45c8-a95f-9cdbad8ffcc4"
          },
          "first_name": {
            "type": "string",
            "example": "Sakshi"
          },
          "last_name": {
            "type": "string",
            "example": "Sharma"
          },
          "email": {
            "type": "string",
            "example": "sakshi@example.com"
          },
          "phone": {
            "type": "object",
            "example": "+91-9000000000"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "last_login_at": {
            "type": "object",
            "example": "2026-01-15T10:30:00.000Z"
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-01T10:00:00.000Z"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-02T12:00:00.000Z"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleResponseDto"
            }
          }
        },
        "required": [
          "id",
          "first_name",
          "last_name",
          "email",
          "is_active",
          "created_at",
          "updated_at"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Sakshi"
          },
          "last_name": {
            "type": "string",
            "example": "Sharma"
          },
          "email": {
            "type": "string",
            "example": "sakshi@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Phone number in correct format (e.g. +919876543210).",
            "example": "+919000000000"
          },
          "password": {
            "type": "string",
            "description": "Plain password; will be hashed and stored as password_hash.",
            "minLength": 8
          },
          "role_codes": {
            "type": "array",
            "description": "Assign initial roles by code. Transaction-safe.",
            "example": [
              "RECRUITER"
            ],
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "RECRUITER",
                "INTERVIEWER",
                "HIRING_MANAGER"
              ]
            }
          },
          "created_by_user_id": {
            "type": "string",
            "description": "Optional audit field. Typically derived from authenticated user.",
            "example": "f3a6b0ea-2b1a-4af1-a4a8-bb2b2a45a7c9"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Sakshi"
          },
          "last_name": {
            "type": "string",
            "example": "Sharma"
          },
          "email": {
            "type": "string",
            "example": "sakshi@example.com"
          },
          "phone": {
            "type": "object",
            "description": "Phone number in correct format (e.g. +919876543210). Use null to clear.",
            "example": "+919000000000"
          },
          "password": {
            "type": "string",
            "description": "New plain password; will be hashed and stored.",
            "minLength": 8
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "updated_by_user_id": {
            "type": "string",
            "description": "Optional audit field. Typically derived from authenticated user.",
            "example": "f3a6b0ea-2b1a-4af1-a4a8-bb2b2a45a7c9"
          }
        }
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 10
          },
          "total_records": {
            "type": "number",
            "example": 57
          },
          "total_pages": {
            "type": "number",
            "example": 6
          },
          "has_next_page": {
            "type": "boolean",
            "example": true
          },
          "has_previous_page": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "page",
          "limit",
          "total_records",
          "total_pages",
          "has_next_page",
          "has_previous_page"
        ]
      },
      "PaginatedResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Records fetched successfully"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "success",
          "message",
          "pagination"
        ]
      }
    }
  }
}